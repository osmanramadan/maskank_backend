NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maskank
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,https://maskankfrontend.vercel.app
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_FILE_SIZE_BYTES=5242880
MAX_PROPERTY_IMAGES=10
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=maskank/properties
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=maskank/properties